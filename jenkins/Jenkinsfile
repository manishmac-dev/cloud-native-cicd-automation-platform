pipeline {
    agent any

    stages {
        stage('1. Prepare SSH Host Keys') {
            steps {
                sh '''
                    mkdir -p ~/.ssh
                    chmod 700 ~/.ssh
                    ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts
                    chmod 600 ~/.ssh/known_hosts
                '''
            }
        }

        stage('2. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('3. Verify Environment & Config') {
            steps {
                sh 'docker --version && docker compose config --quiet'
            }
        }

        stage('4. Build & Deploy 5 Containers') {
            steps {
                sh '''
                    # Point Docker client to Minikube's daemon and disable BuildKit to avoid 404 errors
                    export DOCKER_BUILDKIT=0
                    eval $(minikube docker-env)

                    # Stop and remove existing containers and networks completely
                    docker compose down --volumes --remove-orphans || true
                    
                    # Force remove any lingering conflicting container names
                    docker ps -a --format '{{.Names}}' | grep -E 'postgres-db|user-service|order-service|payment-service|api-gateway' | xargs -r docker rm -f || true
                    
                    # Build and spin up fresh containers inside Minikube Docker daemon
                    docker compose up --build -d
                '''
            }
        }

        stage('5. End-to-End API Smoke Test') {
            steps {
                sh 'sleep 5 && curl -sf http://localhost:8000/api/v1/users && curl -sf http://localhost:8000/api/v1/orders && curl -sf http://localhost:8000/api/v1/payments'
            }
        }
        stage('6. Deploy to Kubernetes Cluster') {
            steps {
                sh '''
                    echo "Applying Kubernetes manifests..."
                    kubectl apply -f k8s/
                    
                    echo "Verifying deployed resources..."
                    kubectl get pods
                    kubectl get services
                '''
            }
        }
    }

    post {
        success {
            echo 'PRODUCTION-STYLE LINUX PIPELINE SUCCEEDED!'
        }
        failure {
            echo 'PIPELINE FAILED! Check stage logs.'
        }
    }
}